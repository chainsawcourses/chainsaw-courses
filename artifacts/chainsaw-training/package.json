{
  "name": "@workspace/chainsaw-training",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "dev:demo": "VITE_DEMO_MODE=true vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "build:demo": "VITE_DEMO_MODE=true vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:uk-english": "node scripts/check-uk-english.mjs",
    "check:privacy-policy": "node --test tests/privacy-policy-consistency.test.ts && node scripts/check-privacy-policy-consistency.mjs",
    "check:manual-pages": "node scripts/check-manual-page-budget.mjs",
    "check:admin-api-error": "node --test tests/admin-api-error.test.ts",
    "test:access-policy": "node --test tests/access-policy.test.ts",
    "test:service-worker": "node --test tests/service-worker.test.ts",
    "test:session-bootstrap": "node --test tests/session-bootstrap.test.ts",
    "test:offline-access": "node --test tests/access-policy.test.ts tests/service-worker.test.ts",
    "test:store-policy": "node --test tests/store-policy.test.ts",
    "test:lifecycle-browser": "playwright test --config ../../playwright.lifecycle.config.ts",
    "test:lifecycle-browser:chromium": "playwright test access-lifecycle.spec.ts video-completion-persistence.spec.ts --config ../../playwright.lifecycle.config.ts --project=chromium-desktop",
    "test:billing-history-browser": "playwright test billing-history.spec.ts --config ../../playwright.lifecycle.config.ts --project=chromium-desktop",
    "test:retailer-directory-browser": "playwright test retailer-directory.spec.ts --config ../../playwright.lifecycle.config.ts --project=chromium-desktop --project=chromium-phone-portrait --project=chromium-phone-landscape --project=chromium-tablet-portrait --project=chromium-tablet-landscape",
    "test:admin-retailer-review-browser": "playwright test admin-retailer-review.spec.ts --config ../../playwright.lifecycle.config.ts --project=chromium-desktop --project=chromium-phone-portrait --project=chromium-phone-landscape",
    "check:admin-retailer-review-browser:webkit": "node --test tests/webkit-retailer-history-selection.test.mjs && node scripts/check-webkit-retailer-history-selection.mjs",
    "test:admin-retailer-review-browser:webkit": "pnpm run check:admin-retailer-review-browser:webkit && node scripts/run-webkit-retailer-history.mjs",
    "test:manual-cache": "node --test tests/manual-page-cache.test.ts",
    "test:manual-page-budget": "node --test tests/manual-page-budget.test.ts",
    "test:manual-delivery-analytics": "node --test tests/manual-delivery-analytics.test.ts",
    "check:manual-delivery-browser": "node --test tests/manual-recovery-selection.test.mjs && node scripts/check-manual-recovery-selection.mjs",
    "test:manual-delivery-browser": "pnpm run check:manual-delivery-browser && node scripts/run-manual-recovery.mjs",
    "check:mobile-packages": "node ../../scripts/check-mobile-package-boundaries.mjs",
    "android:sync": "cap sync android && pnpm run check:mobile-packages",
    "android:bundle:release": "cap sync android && pnpm run check:mobile-packages && cd android && ./gradlew bundleRelease"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
