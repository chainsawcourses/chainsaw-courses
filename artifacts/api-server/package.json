{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "backup:scheduled": "node ./dist/scripts/run-scheduled-backup.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:certificate-layout": "node --test tests/certificate-layout.test.ts",
    "check:privacy-policy-pdf": "node --test tests/privacy-policy-pdf.test.ts tests/privacy-policy-route.test.ts",
    "check:remote-pdf": "node --test tests/remote-pdf.test.ts",
    "check:gateway-venue": "pnpm run build && node --test tests/gateway-venue.test.ts tests/gateway-venue-routes.test.ts",
    "check:retailers": "pnpm run build && node --test tests/retailer-routes.test.ts tests/retailer-review-reminders.test.ts tests/retailer-logo-storage.test.ts",
    "check:course-access": "pnpm run build && node --test tests/course-access.test.ts tests/course-access-routes.test.ts tests/progress-routes.test.ts",
    "check:assessment-media": "pnpm run build && node --test tests/assessment-media-storage.test.ts tests/assessment-media-reconciliation.test.ts",
    "check:enrollment": "pnpm run build && node --test tests/enrollment.test.ts",
    "check:subscription": "pnpm run build && node --test tests/subscription-events.test.ts tests/subscription-routes.test.ts",
    "check:billing-monitoring": "node --test ../../scripts/check-production-billing-monitoring.test.mjs",
    "check:production-billing-monitoring": "pnpm run check:billing-monitoring && node ../../scripts/check-production-billing-monitoring.mjs",
    "check:full-backup-restore": "node scripts/check-full-backup-restore.mjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@google-cloud/storage": "^7.17.3",
    "@google/genai": "^2.8.0",
    "@napi-rs/canvas": "^1.0.2",
    "@replit/connectors-sdk": "^0.4.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/retailer-review-policy": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^10.5.0",
    "mammoth": "^1.12.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.1.0",
    "openai": "^6.44.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "rss-parser": "^3.13.0",
    "web-push": "^3.6.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
